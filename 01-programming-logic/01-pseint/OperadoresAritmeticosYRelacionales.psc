Algoritmo OperadoresAritmeticos
	// Operadores Aritmeticos
	// suma +
	a = 3 + 4
	Imprimir 'Suma: ', a
	// Resta -
	b = 6 -2
	Imprimir 'Resta: ', b
	//Multiplicacion
	c = a * 2
	Imprimir 'Multiplicacion: ', c
	// Division
	d = b / c
	Imprimir 'Division: ', d
	// Potencia ^
	e = a ^ 2
	Imprimir 'Potencia: ', e
	// Modulo (residuo division)
	f = 9 % 4
	Imprimir 'Modulo: ',f
	
	//Operadores Relacionales
	// Operadores de igualdad
	g = 5 == 6
	Imprimir 'Operador de igualdad: ',g
	// Operadores de distinto
	h = 5 <> 6
	Imprimir 'Operador de distinto ',h
	// Mayor que
	i = 6 > 5
	Imprimir 'operador mayor que: ', i
	// Mayor o igual que
	j = 6 >= 5
	Imprimir 'operador mayor o igual que: ',j
	// Menor que
	k = 6 < 5
	Imprimir 'operador menor que: ',k
	// Menor o igual que
	l = 6 <= 5
	Imprimir 'operador menor o igual que: ',l
	
FinAlgoritmo
