Algoritmo OperadoresLogicos
	a = Verdadero
	b = Falso
	Imprimir 'Valor a: ', a
	Imprimir 'Valor b: ',b
	
	//operador Logico Y
	// Regresa verdadero si ambos operandos son verdaderos
	c = a Y b
	Imprimir 'Valor c: ',c
	
	// Operador Logico O
	// Regresa verdadero si cualquier operando es verdadero
	c = a O b
	Imprimir 'valor c: ', c
	
	// Operador Logico NO
	c = NO a
	Imprimir 'valor c: ',c
	
FinAlgoritmo
